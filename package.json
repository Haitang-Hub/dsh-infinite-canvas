{
  "name": "@haitang-hub/dsh-infinite-canvas",
  "version": "0.2.35",
  "description": "无限画布：Agent 驱动的无限 AI 创作画布，节点上编排并生成文本/图片/视频/音频，内置零依赖本地桥（MCP + 浏览器工具执行器）、技能与节点插件市场",
  "icon": "./icon.png",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./icon": "./icon.png",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "bridge",
    "site",
    "icon.png",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "pack:all": "npm run sync && npm pack"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "Haitang-Hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haitang-Hub/dsh-infinite-canvas.git",
    "directory": "dsh-plugin"
  },
  "keywords": [
    "dsh-plugin",
    "workbench",
    "infinite-canvas",
    "mcp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
